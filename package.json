{
  "name": "tikit",
  "version": "1.0.0",
  "private": true,
  "description": "TIKIT – billettplattform for russ og arrangementer",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch --clear-screen=false src/node/main.ts",
    "dev:web": "vite",
    "demo": "vite --mode demo",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:demo": "vite build --mode demo && node scripts/make-artifact.mjs",
    "start": "node dist/server/main.js",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:sql": "vitest run --config vitest.sql.config.ts",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "vipps:webhook": "tsx scripts/register-vipps-webhook.ts",
    "doctor": "tsx scripts/doctor.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "postgres": "^3.4.9",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@playwright/test": "1.56",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  }
}
