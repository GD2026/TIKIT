# ─────────────────────────────────────────────────────────────────────────────
# TIKIT – miljøvariabler. Kopier til .env og fyll inn. Aldri legg .env i git.
#
#   npm run doctor            viser hva som er koblet til, hva som mangler og hvilke adresser du registrerer hvor
#   npm run doctor -- --online  tester nøklene mot Supabase, Vipps, Google, Apple, Stripe og Resend
#
# Uten nøkler kjører alt i demomodus: innlogging og betaling simuleres. Du kan koble på én tjeneste av gangen.
# Steg-for-steg for hver tjeneste: docs/oppsett.md. iOS-appen: docs/ios.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Drift ────────────────────────────────────────────────────────────────────
# production i drift
NODE_ENV=development
PORT=8787
# Adressen folk bruker, uten / på slutten. I drift: https://tikit.no (brukes også av iOS-appen og i alle lenker)
PUBLIC_URL=http://localhost:5173
# minst 32 tegn: openssl rand -base64 48 (Render lager den selv)
SESSION_SECRET=
# false før ekte salg. I produksjon kan demomodus ikke kombineres med ekte nøkler.
DEMO_MODE=true
# legger inn eksempeldata i en tom database (bare i demomodus)
SEED_DEMO_DATA=true
# kommaseparert; disse e-postene blir plattformadmin ved innlogging
ADMIN_EMAILS=
# 1 bak Render/Fly/Heroku/nginx (bruker X-Forwarded-For)
TRUST_PROXY=0
# header der proxyen foran legger kundens ekte IP (Render/Cloudflare: cf-connecting-ip). Brukes før TRUST_PROXY.
CLIENT_IP_HEADER=
# bakgrunnsjobber (utløpte reservasjoner, varsler, påminnelser, sletting etter lagringstid)
CRON_INTERVAL_SECONDS=30
# valgfritt: POST /api/cron med denne som Bearer-token
CRON_SECRET=

# ── Selskapet som driver TIKIT ───────────────────────────────────────────────
# vises som formidler i kjøpsvilkår, kvitteringer og hjelp. SUPPORT_EMAIL får også rapporter om innhold (App Store 1.2).
OPERATOR_NAME=
OPERATOR_ORG_NUMBER=
SUPPORT_EMAIL=

# ── Database: Supabase (eller annen Postgres 14+) ────────────────────────────
# Supabase: Project → Connect → «Session pooler» → kopier URI-en (postgresql://postgres.<ref>:<passord>@aws-0-<region>.pooler.supabase.com:5432/postgres).
#   Bruk ikke «Direct connection» (db.<ref>.supabase.co) på Render – den har bare IPv6.
#   Transaction pooler (port 6543) virker også; TIKIT slår da av prepared statements selv.
# Render Postgres: settes automatisk av render.yaml.
# Uten DATABASE_URL brukes innebygd PGlite i DATA_DIR (bare for utvikling – serveren nekter i produksjon).
DATABASE_URL=
# PEM-innholdet i Supabase sitt CA-sertifikat (Database Settings → SSL), linjeskift som \n. Gir full sertifikatsjekk.
DATABASE_CA_CERT=
# require | prefer | disable (tom = automatisk; Supabase får alltid require)
DATABASE_SSL=
ALLOW_EMBEDDED_DB=false
DATA_DIR=./data

# ── Vipps MobilePay (Logg inn med Vipps + betaling) ──────────────────────────
# portal.vippsmobilepay.com → For utviklere → API-nøkler. Redirect URI: <PUBLIC_URL>/api/auth/callback/vipps
# test | production
VIPPS_ENV=test
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
# Merchant Serial Number (salgsenhet)
VIPPS_MSN=
# fra: npm run vipps:webhook (påkrevd i produksjon når Vipps-betaling er på)
VIPPS_WEBHOOK_SECRET=
VIPPS_LOGIN_ENABLED=true
VIPPS_PAYMENTS_ENABLED=true

# ── Google ───────────────────────────────────────────────────────────────────
# console.cloud.google.com → Google Auth Platform → Clients → Web application.
# Authorized redirect URI: <PUBLIC_URL>/api/auth/callback/google (gjelder også iOS-appen)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Sign in with Apple ───────────────────────────────────────────────────────
# developer.apple.com → Certificates, Identifiers & Profiles. Samme nøkkel brukes av nettsiden og iOS-appen.
# Services ID for nettsiden, f.eks. no.tikit.web. Return URL: <PUBLIC_URL>/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# innholdet i AuthKey_XXXX.p8, linjeskift som \n
APPLE_PRIVATE_KEY=

# ── iOS-appen (docs/ios.md) ──────────────────────────────────────────────────
# Bundle ID for appen (App ID i Apple Developer). Slår på universal links (/.well-known/apple-app-site-association)
# og innebygd «Logg på med Apple». Trenger APPLE_TEAM_ID, APPLE_KEY_ID og APPLE_PRIVATE_KEY over.
APPLE_BUNDLE_IDS=
# URL-skjemaet i appen (Info.plist). Endre bare hvis du endrer det i Xcode også.
APP_URL_SCHEME=tikit
# Opprinnelsen til appens web view – trenger ikke endres.
APP_CORS_ORIGINS=capacitor://localhost

# ── App Review-tilgang (docs/app-store/review-notes.md) ──────────────────────
# Sett begge mens Apple ser gjennom appen, og tøm dem etterpå. Koden: openssl rand -hex 12
REVIEW_LOGIN_EMAIL=
REVIEW_LOGIN_CODE=

# ── Kortbetaling (Stripe Checkout) ───────────────────────────────────────────
# dashboard.stripe.com → Developers. Webhook: <PUBLIC_URL>/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Lommebok: Apple Wallet og Google Wallet (docs/oppsett.md §9) ─────────────
# Billetten som kort i Wallet: åpnes fra låseskjermen eller med dobbeltklikk på sideknappen. Valgfritt.
# Apple: Pass Type ID-sertifikatet (pass.cer → PEM) og nøkkelen, linjeskift som \n. Pass Type ID og team leses fra sertifikatet.
APPLE_WALLET_CERT=
APPLE_WALLET_KEY=
# bare hvis nøkkelen er kryptert
APPLE_WALLET_KEY_PASSPHRASE=
# tom = innebygd Apple WWDR G4 (riktig for alle nye sertifikater)
APPLE_WALLET_WWDR_CERT=
# Google: Issuer ID fra pay.google.com/business/console og hele JSON-nøkkelen til tjenestekontoen (på én linje)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT=

# ── E-post (Resend) ──────────────────────────────────────────────────────────
# resend.com. Domenet i MAIL_FROM må være verifisert. Påkrevd i produksjon.
RESEND_API_KEY=
MAIL_FROM=TIKIT <billetter@example.no>
MAIL_REPLY_TO=
