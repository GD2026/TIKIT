# ─────────────────────────────────────────────────────────────────────────────
# TIKIT – miljøvariabler. Kopier til .env og fyll inn. Aldri legg .env i git.
# Alt som mangler en nøkkel blir simulert når DEMO_MODE=true.
# ─────────────────────────────────────────────────────────────────────────────

# Drift
# production i drift
NODE_ENV=development
PORT=8787
# i drift: https://tikit.no (uten / på slutten)
PUBLIC_URL=http://localhost:5173
# minst 32 tegn: openssl rand -base64 48
SESSION_SECRET=
# false før ekte salg. I produksjon kan demomodus ikke kombineres med ekte nøkler.
DEMO_MODE=true
# legger inn eksempeldata i en tom database (bare i demomodus)
SEED_DEMO_DATA=true
# kommaseparert; disse e-postene blir plattformadmin ved innlogging
ADMIN_EMAILS=
# 1 bak Render/Fly/Heroku/nginx (bruker X-Forwarded-For)
TRUST_PROXY=0
# header der proxyen foran legger kundens ekte IP (Render/Cloudflare: cf-connecting-ip). Brukes før TRUST_PROXY.
CLIENT_IP_HEADER=
# bakgrunnsjobber (utløpte reservasjoner, varsler, påminnelser)
CRON_INTERVAL_SECONDS=30
# valgfritt: POST /api/cron med denne som Bearer-token
CRON_SECRET=

# Selskapet som driver TIKIT (vises som formidler i kjøpsvilkår, kvitteringer og hjelp)
OPERATOR_NAME=
OPERATOR_ORG_NUMBER=
SUPPORT_EMAIL=

# Database – Postgres 14+ (Neon, Supabase, Render …). Uten DATABASE_URL brukes innebygd PGlite i DATA_DIR.
# I produksjon kreves DATABASE_URL; ALLOW_EMBEDDED_DB=true tillater PGlite likevel (bare for en ren demo).
DATABASE_URL=
ALLOW_EMBEDDED_DB=false
# require | prefer | disable (tom = som i URL-en)
DATABASE_SSL=
DATA_DIR=./data

# Vipps MobilePay (Logg inn med Vipps + ePayment). Nøklene finner du i portal.vippsmobilepay.com
# test | production
VIPPS_ENV=test
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
# Merchant Serial Number (salgsenhet)
VIPPS_MSN=
# fra: npm run vipps:webhook (påkrevd i produksjon når Vipps-betaling er på)
VIPPS_WEBHOOK_SECRET=
VIPPS_LOGIN_ENABLED=true
VIPPS_PAYMENTS_ENABLED=true

# Google (console.cloud.google.com → APIs & Services → Credentials → OAuth client ID, type Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (developer.apple.com → Certificates, IDs & Profiles)
# Services ID, f.eks. no.tikit.web
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# innholdet i AuthKey_XXXX.p8, linjeskift som \n
APPLE_PRIVATE_KEY=

# Kortbetaling (Stripe Checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-post (Resend). Domenet må være verifisert i Resend. Påkrevd i produksjon.
RESEND_API_KEY=
MAIL_FROM=TIKIT <billetter@example.no>
MAIL_REPLY_TO=
